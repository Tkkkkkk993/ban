[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/organizer.gd" id="1_script"]

; ============================================================
;  Organizer.tscn —— 组织者模式（收票 + 汇总 + 出结果）
; ------------------------------------------------------------
;    Organizer (Control)                    ← organizer.gd
;      └ Root (PanelContainer)
;          └ VBox
;              ├ HeaderBox (PanelContainer)        标题 + 返回玩家模式
;              ├ ToolbarWrap (PanelContainer)
;              │    └ ToolbarScroll > Toolbar      按钮由 organizer.gd 创建
;              ├ SummaryBox (PanelContainer)       参与人数 / 总 Ban 次数 / 异常
;              ├ Body (ScrollContainer)
;              │    └ BodyBox (VBoxContainer)
;              │        ├ TopGrid (GridContainer)          Top N 头像网格
;              │        └ DetailLabel (RichTextLabel)      排序明细
;              └ StatusBarWrap (PanelContainer) > StatusLabel
;
;  支持把 json 文件直接拖进窗口导入。
; ============================================================

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_root"]
bg_color = Color(0.0784314, 0.0784314, 0.0784314, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_header"]
bg_color = Color(0.145098, 0.101961, 0.0352941, 1)
content_margin_left = 14.0
content_margin_top = 8.0
content_margin_right = 14.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_toolbar"]
bg_color = Color(0.129412, 0.129412, 0.129412, 1)
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_summary"]
bg_color = Color(0.101961, 0.101961, 0.101961, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.227451, 0.227451, 0.227451, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 12.0
content_margin_top = 6.0
content_margin_right = 12.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_status"]
bg_color = Color(0.113725, 0.113725, 0.113725, 1)
content_margin_left = 12.0
content_margin_top = 5.0
content_margin_right = 12.0
content_margin_bottom = 5.0

[node name="Organizer" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Root" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_root")

[node name="VBox" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="HeaderBox" type="PanelContainer" parent="Root/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_header")

[node name="HeaderRow" type="HBoxContainer" parent="Root/VBox/HeaderBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ModeLabel" type="Label" parent="Root/VBox/HeaderBox/HeaderRow"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.419608, 0, 1)
theme_override_font_sizes/font_size = 15
text = "组织者模式 · 汇总"
vertical_alignment = 1

[node name="HintLabel" type="Label" parent="Root/VBox/HeaderBox/HeaderRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.603922, 0.603922, 0.603922, 1)
theme_override_font_sizes/font_size = 11
text = "把群友发来的 vote_*.json 拖进这个窗口，或点「导入文件 / 导入文件夹」"
vertical_alignment = 1

[node name="Spacer" type="Control" parent="Root/VBox/HeaderBox/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="PlayerModeBtn" type="Button" parent="Root/VBox/HeaderBox/HeaderRow"]
layout_mode = 2
text = "返回玩家模式"

[node name="ToolbarWrap" type="PanelContainer" parent="Root/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_toolbar")

[node name="ToolbarScroll" type="ScrollContainer" parent="Root/VBox/ToolbarWrap"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
vertical_scroll_mode = 0

[node name="Toolbar" type="HBoxContainer" parent="Root/VBox/ToolbarWrap/ToolbarScroll"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SummaryWrap" type="MarginContainer" parent="Root/VBox"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 0

[node name="SummaryBox" type="PanelContainer" parent="Root/VBox/SummaryWrap"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_summary")

[node name="SummaryVBox" type="VBoxContainer" parent="Root/VBox/SummaryWrap/SummaryBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="SummaryLabel" type="Label" parent="Root/VBox/SummaryWrap/SummaryBox/SummaryVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.909804, 0.909804, 0.909804, 1)
theme_override_font_sizes/font_size = 13
text = "还没有导入任何投票文件"
autowrap_mode = 2

[node name="DetailLabel" type="Label" parent="Root/VBox/SummaryWrap/SummaryBox/SummaryVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.603922, 0.603922, 0.603922, 1)
theme_override_font_sizes/font_size = 11
text = ""
autowrap_mode = 2

[node name="Body" type="ScrollContainer" parent="Root/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/scroll_deadzone = 4

[node name="BodyBox" type="VBoxContainer" parent="Root/VBox/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="BodyMargin" type="MarginContainer" parent="Root/VBox/Body/BodyBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_bottom = 10

[node name="TopGrid" type="GridContainer" parent="Root/VBox/Body/BodyBox/BodyMargin"]
layout_mode = 2
columns = 5

[node name="StatusBarWrap" type="PanelContainer" parent="Root/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_status")

[node name="StatusLabel" type="Label" parent="Root/VBox/StatusBarWrap"]
layout_mode = 2
theme_override_colors/font_color = Color(0.658824, 0.658824, 0.658824, 1)
theme_override_font_sizes/font_size = 11
text = "等待导入"
autowrap_mode = 2
