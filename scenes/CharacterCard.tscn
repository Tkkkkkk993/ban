[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/character_card.gd" id="1_script"]

; ============================================================
;  CharacterCard.tscn —— 忍者卡片（140 x 196）
; ------------------------------------------------------------
;  节点树（脚本通过 @onready 引用这些节点，不再自己新建节点）：
;
;    CharacterCard (Control)                     140x196，接收左右键
;      └ CardPanel (PanelContainer)              外层，橙色选中描边
;          └ BgPanel (PanelContainer)            内层，卡片底色
;              └ Margin (MarginContainer)        内边距
;                  └ VBox (VBoxContainer)
;                      ├ ImageFrame (PanelContainer)
;                      │    ├ Center > Avatar (TextureRect)   116x116 头像
;                      │    └ Placeholder (Label)             "?"  无图占位
;                      ├ NameLabel (Label)                    忍者名
;                      └ VotersLabel (Label)                  被谁 Ban
;      └ BadgeHolder (MarginContainer)           右上角，浮在卡片上
;          └ Badge (Label)                       票数徽章
;
;  所有颜色/圆角/阴影都在 character_card.gd 的 _apply_styles() 里用
;  StyleBoxFlat 动态生成，这里的 StyleBoxFlat 只是让编辑器预览不难看。
;  子节点统一 mouse_filter=2(IGNORE)，鼠标事件由根节点统一处理。
; ============================================================

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card_bg"]
bg_color = Color(0.164706, 0.164706, 0.164706, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_outline"]
bg_color = Color(0.164706, 0.164706, 0.164706, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.419608, 0, 1)
corner_radius_top_left = 11
corner_radius_top_right = 11
corner_radius_bottom_right = 11
corner_radius_bottom_left = 11

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_frame"]
bg_color = Color(0.121569, 0.121569, 0.121569, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.239216, 0.239216, 0.239216, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_badge"]
bg_color = Color(1, 0.419608, 0, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_holder"]

[node name="CharacterCard" type="Control"]
custom_minimum_size = Vector2(140, 206)
anchors_preset = 0
offset_right = 140.0
offset_bottom = 206.0
mouse_filter = 0
script = ExtResource("1_script")

[node name="CardPanel" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_outline")

[node name="BgPanel" type="PanelContainer" parent="CardPanel"]
layout_mode = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card_bg")

[node name="Margin" type="MarginContainer" parent="CardPanel/BgPanel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 4

[node name="VBox" type="VBoxContainer" parent="CardPanel/BgPanel/Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="ImageFrame" type="PanelContainer" parent="CardPanel/BgPanel/Margin/VBox"]
custom_minimum_size = Vector2(112, 112)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_frame")

[node name="Center" type="CenterContainer" parent="CardPanel/BgPanel/Margin/VBox/ImageFrame"]
layout_mode = 2
mouse_filter = 2

[node name="Avatar" type="TextureRect" parent="CardPanel/BgPanel/Margin/VBox/ImageFrame/Center"]
custom_minimum_size = Vector2(112, 112)
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Placeholder" type="Label" parent="CardPanel/BgPanel/Margin/VBox/ImageFrame"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.333333, 0.333333, 0.333333, 1)
theme_override_font_sizes/font_size = 34
text = "?"
horizontal_alignment = 1
vertical_alignment = 1

[node name="NameLabel" type="Label" parent="CardPanel/BgPanel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_override_colors/font_color = Color(0.909804, 0.909804, 0.909804, 1)
theme_override_font_sizes/font_size = 13
text = "—"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="VotersLabel" type="Label" parent="CardPanel/BgPanel/Margin/VBox"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.603922, 0.603922, 0.603922, 1)
theme_override_font_sizes/font_size = 10
horizontal_alignment = 1
vertical_alignment = 1

[node name="BadgeHolder" type="MarginContainer" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -30.0
offset_top = 4.0
offset_right = -5.0
offset_bottom = 28.0
grow_horizontal = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxEmpty_holder")

[node name="Badge" type="Label" parent="BadgeHolder"]
custom_minimum_size = Vector2(25, 24)
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 13
text = "✓"
horizontal_alignment = 1
vertical_alignment = 1
